    "name": "Tienda de Libros Virtual - API REST (Seguridad JWT)",
    "description": "Colección con login JWT y pruebas de rutas protegidas por rol (ADMIN / CLIENTE).\n\nUsuarios de prueba: admin/admin123 (ADMIN) y cliente/cliente123 (CLIENTE).\n\nEjecutar en orden con el Collection Runner: los requests de la carpeta 1 guardan los tokens en variables que usan las demás carpetas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "libroId",
      "value": "1"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenCliente",
      "value": ""
    },
    {
      "key": "tokenInvalido",
      "value": "esto.no.es.un.jwt"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "1.1 Login ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login correcto (200)\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Devuelve token JWT y rol ADMIN\", function () {",
                  "  pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(json.rol).to.eql(\"ADMIN\");",
                  "});",
                  "pm.collectionVariables.set(\"tokenAdmin\", json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Guarda el token en la variable {{tokenAdmin}}."
          }
        },
        {
          "name": "1.2 Login CLIENTE",
